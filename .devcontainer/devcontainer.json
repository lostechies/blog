{
  "name": "Hugo website",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [
    // Hugo server
    1313
  ],
  "postCreateCommand": "wget -qO - https://github.com/gohugoio/hugo/releases/download/v0.166.0/hugo_0.166.0_linux-amd64.tar.gz | tar zx -C /usr/local/bin hugo"
}
